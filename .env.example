# Database configuration
POSTGRES_USER=smart_user
POSTGRES_PASSWORD=smart_password
POSTGRES_DB=smart_directory
DB_HOST=db
DB_PORT=5432

# Active Directory configuration
AD_SERVER=ldap://ad.example.local
AD_USER=CN=SyncUser,OU=ServiceAccounts,DC=example,DC=local
AD_PASSWORD=your_secure_ad_password
AD_BASE_DN=DC=example,DC=local

# Security
SECRET_KEY=your_super_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
