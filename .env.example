# ==============================================================================
# Smart Directory - Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Do not commit the actual .env file to version control!

# --- PostgreSQL Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=smart_contacts
DB_HOST=db
DB_PORT=5432

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Security & JWT (API Gateway) ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of allowed origins for CORS protection
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
# Comma-separated list of trusted reverse proxy IPs / subnets for ProxyHeadersMiddleware
TRUSTED_PROXIES=127.0.0.1,172.28.10.0/24
# Comma-separated list of logins (sAMAccountName) to be granted IT-Operator role on first login
INIT_ADMINS=admin_login1,admin_login2
# Progressive Brute-force Protection (free attempts threshold, base ban, max ban, activity window)
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_BASE_BAN_SECONDS=180
BRUTE_FORCE_MAX_BAN_SECONDS=3600
BRUTE_FORCE_WINDOW_SECONDS=3600

# --- Development Bypass (Optional) ---
# Set these to enable authentication without Active Directory for local development
DEV_USER=dev_admin
DEV_PASSWORD=dev_password

# --- Active Directory Synchronization ---
# LDAP server address (e.g., ldaps://dc.domain.local:636 for secure LDAPS)
AD_SERVER=ldaps://your-dc-address:636
# TLS certificate validation for LDAPS (False is required for production security)
AD_INSECURE_SKIP_VERIFY=False
# Path to the corporate CA certificate bundle for TLS verification (e.g., /app/certs/ca.pem)
AD_CA_CERT_PATH=/app/certs/ca.pem
# Service account credentials for synchronization
AD_USER=CN=ServiceAccount,OU=ServiceAccounts,DC=domain,DC=local
AD_PASSWORD=your_service_account_password
# Root DN for user search
AD_BASE_DN=OU=Users,DC=domain,DC=local

# Sync Worker Settings
AD_PULL_INTERVAL_SECONDS=3600
AD_MAX_RETRIES=5
AD_RETRY_BASE_SECONDS=10

# --- Frontend Configuration ---
# Base URL for the API (used by Vite during build/runtime)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Paths & Files ---
# Path to the file with organization names/filters (relative to worker app root)
CN_LIST_PATH=docs/CN.md
