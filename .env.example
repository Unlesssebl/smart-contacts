# ==============================================================================
# Smart Directory - Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Do not commit the actual .env file to version control!

# --- PostgreSQL Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=smart_contacts
DB_HOST=db
DB_PORT=5432

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Security & JWT (API Gateway) ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of logins (sAMAccountName) to be granted IT-Operator role on first login
INIT_ADMINS=admin_login1,admin_login2

# --- Development Bypass (Optional) ---
# Set these to enable authentication without Active Directory for local development
DEV_USER=dev_admin
DEV_PASSWORD=dev_password

# --- Active Directory Synchronization ---
# LDAP server address (e.g., ldap://dc.domain.local or ldaps://dc.domain.local)
AD_SERVER=ldap://your-dc-address
# Service account credentials for synchronization
AD_USER=CN=ServiceAccount,OU=ServiceAccounts,DC=domain,DC=local
AD_PASSWORD=your_service_account_password
# Root DN for user search
AD_BASE_DN=OU=Users,DC=domain,DC=local

# Sync Worker Settings
AD_PULL_INTERVAL_SECONDS=3600
AD_MAX_RETRIES=5
AD_RETRY_BASE_SECONDS=10

# --- Frontend Configuration ---
# Base URL for the API (used by Vite during build/runtime)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Paths & Files ---
# Path to the file with organization names/filters (relative to worker app root)
CN_LIST_PATH=docs/CN.md
