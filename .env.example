# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=smart_contacts
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- API Gateway (FastAPI) ---
SECRET_KEY=generate_a_very_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Active Directory Synchronization ---
AD_SERVER=ldap://your-ad-server.local
AD_USER=CN=SyncUser,OU=ServiceAccounts,DC=company,DC=local
AD_PASSWORD=your_ad_password
AD_BASE_DN=DC=company,DC=local
AD_PULL_INTERVAL_SECONDS=3600

# --- Web Frontend ---
VITE_API_BASE_URL=http://localhost:8000
