# ==============================================================================
# Smart Directory - Development Environment Overrides Example (.env.dev)
# ==============================================================================
# Эти параметры можно использовать для локальной разработки поверх .env.
# Включает работу без обязательного валидного HTTPS и тестовый режим.

COOKIE_SECURE=False
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development Account (Bypass Active Directory for offline local work)
# DEV_USER=dev_admin
# DEV_PASSWORD=dev_password
